# ==========================================
# AutoMLOps Environment Configuration
# ==========================================

# 1. GitHub Authentication
# Option A: GitHub Personal Access Token (PAT) for quick setup / API access
# Generate from: https://github.com/settings/tokens (classic, with 'repo' scope)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Option B: GitHub App / OAuth App Authentication
# Created from: https://github.com/settings/apps or https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./github_app_private_key.pem

# Webhook Secret: HMAC secret chosen when setting up GitHub webhook
GITHUB_WEBHOOK_SECRET=automlops-dev-secret

# Backend callback URL (used by local runner thread to report status)
BACKEND_CALLBACK_URL=http://localhost:8000

# 2. Discord Webhooks (Alerting)
# From Discord Channel -> Settings -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url
DISCORD_MENTION_CRITICAL=false

# 3. Database
DATABASE_URL=sqlite:///./automlops.db

# 4. MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000

# 5. Production Retraining Circuit Breaker
# Maximum allowed automated retrain cycles per 24 hours per repository
MAX_AUTO_RETRAINS_PER_24H=3

# 6. Deployment & Tunnel (Cloudflare or Local Subprocess Fallback)
# Set to 'true' to skip cloudflared binary checks and directly use http://localhost:<port>
CLOUDFLARE_TUNNEL_DISABLED=false
CLOUDFLARED_BIN=cloudflared

# 7. Traffic Logging
TRAFFIC_LOGS_DIR=logs

# 8. Environment Mode
ENVIRONMENT=development
