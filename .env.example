# ==========================================
# AutoMLOps Environment Configuration
# ==========================================

# 1. GitHub API Authentication
# Option A (Simpler for demo / individual use): GitHub Personal Access Token (PAT)
# Generate from: https://github.com/settings/tokens (classic, with 'repo' scope)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Option B (Production): GitHub App Authentication
# Created from: https://github.com/settings/apps
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./github_app_private_key.pem

# Webhook Secret: A secret string you choose when configuring the Webhook in GitHub repo settings
GITHUB_WEBHOOK_SECRET=automlops-dev-secret

# 2. Discord Webhooks (Alerting)
# From Discord Channel -> Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url
DISCORD_MENTION_CRITICAL=false

# 3. Database
DATABASE_URL=sqlite:///./automlops.db

# 4. MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000

# 5. Production Retraining Circuit Breaker
# Maximum allowed automated retrain cycles per 24 hours per repository
MAX_AUTO_RETRAINS_PER_24H=3

# 6. Deployment & Tunnel (Cloudflare or Local Proxy)
# Optional: if using an active Cloudflare Tunnel
CLOUDFLARE_TUNNEL_URL=
TUNNEL_DOMAIN=tunnel.automlops.local

# 7. Environment Mode
ENVIRONMENT=development
